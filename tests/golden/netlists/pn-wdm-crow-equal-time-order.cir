WG2b r2b_in r2b_out L=2.93772817e-05 att=2 neff=2.2 ng=4.3
WG3a r3a_in r3a_out L=2.77391339e-05 att=2 neff=2.2 ng=4.3
WG3b r3b_in r3b_out L=3.33566726e-05 att=2 neff=2.2 ng=4.3
MLPROBE_THROUGH through wl=[1.55120301459e-06, 1.55040079748e-06, 1.54959940969e-06, 1.54879884993e-06]
MLPROBE_R2B_OUT r2b_out wl=[1.55120301459e-06, 1.55040079748e-06, 1.54959940969e-06, 1.54879884993e-06]
MLPROBE_DROP drop wl=[1.55120301459e-06, 1.55040079748e-06, 1.54959940969e-06, 1.54879884993e-06]
