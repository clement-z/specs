option('native', type: 'boolean', value: false,
       description: 'Compile with -march=native: faster on the build host, but the binaries only run on CPUs like it and results differ from the golden baseline in the last bits (B-183)')
option('signal_ids', type: 'boolean', value: false,
       description: 'Debug ids of optical signals, printed as [NNNN] in signal listings (defines SPECS_SIGNAL_IDS; every copy of a signal then bumps a global counter)')
option('old_tb', type: 'boolean', value: true,
       description: 'Build the legacy testbenches in src/tb (specs -t/-p); defines BUILD_TB=1 for specs')
option('spx', type: 'boolean', value: false,
       description: 'Build and install libspx.so by default (otherwise: meson compile -C <builddir> spx)')
option('tests', type: 'feature', value: 'auto',
       description: 'GoogleTest unit tests (system gtest, else the subprojects/gtest.wrap fallback)')
option('golden', type: 'boolean', value: true,
       description: 'Register the golden-output regression test (meson test --suite golden)')
option('docs', type: 'feature', value: 'auto',
       description: 'Doxygen documentation run target (ninja -C <builddir> doc)')
